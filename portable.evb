<?xml version="1.0" encoding="UTF-8"?>
<enigmavb>
    <properties>
        <check_vm_registry_keys>false</check_vm_registry_keys>
        <compress_files>true</compress_files>
        <delete_extracted_files>true</delete_extracted_files>
        <share_virtual_system_to_child_processes>false</share_virtual_system_to_child_processes>
        <map_executable_files_with_temporary_file>false</map_executable_files_with_temporary_file>
        <allow_running_of_virtual_exe_files>false</allow_running_of_virtual_exe_files>
        <strip_relocation>true</strip_relocation>
    </properties>
    <input_file>build-static\Release\蕾米埃尔桌宠_Qt6.exe</input_file>
    <output_file>release\蕾米埃尔桌宠_Qt6_portable.exe</output_file>
    <files>
    </files>
</enigmavb>
